# ==========================================================
# SERVER CONFIG
# ==========================================================
HOST=0.0.0.0
PORT=8000

# ==========================================================
# LITELLM (Primary text/image/video provider)
# ==========================================================
LOCAL_API_KEY=YOUR_LITELLM_API_KEY_HERE
BASE_URL=YOUR_LITELLM_BASE_URL_HERE
LITELLM_TEXT_MODEL=YOUR_LITELLM_TEXT_MODEL_HERE
VIDEO_MODEL=YOUR_LITELLM_VIDEO_MODEL_HERE

# ==========================================================
# PROVIDER SELECTION (optional, defaults to "litellm")
# ==========================================================
# TEXT_PROVIDER=litellm
# IMAGE_PROVIDER=litellm
# VIDEO_PROVIDER=litellm

# ==========================================================
# GROQ (Alternative text provider)
# ==========================================================
# GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
# TEXT_MODEL=YOUR_GROQ_TEXT_MODEL_HERE

# ==========================================================
# GEMINI (Alternative image provider)
# ==========================================================
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# IMAGE_MODEL=YOUR_GEMINI_IMAGE_MODEL_HERE

# ==========================================================
# CLOUDFLARE WORKERS AI (Alternative image provider)
# ==========================================================
# CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID_HERE
# CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN_HERE
# CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# ==========================================================
# GOOGLE VERTEX AI (Alternative video provider)
# ==========================================================
# GOOGLE_APPLICATION_CREDENTIALS=./credentials/vertex.json
# GOOGLE_CLOUD_PROJECT=YOUR_GCP_PROJECT_ID_HERE
# VERTEX_LOCATION=us-central1
# VERTEX_MODEL=veo-2.0-generate-001
# VERTEX_OUTPUT_GCS_URI=gs://YOUR_BUCKET/videos/

# ==========================================================
# WAHA (WhatsApp API)
# ==========================================================
WAHA_URL=https://waha.carubra.com
WAHA_API_KEY=
WAHA_SESSION=carubra_phone

# ==========================================================
# GOOGLE DRIVE (optional — uses hardcoded folder ID if unset)
# ==========================================================
# DRIVE_ROOT_FOLDER_ID=YOUR_GOOGLE_DRIVE_ROOT_FOLDER_ID_HERE
